# ==========================================
# Loouwd Application Configuration
# ==========================================

APP_NAME="loouwd API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

HOST="127.0.0.1"
PORT=8000

# ==========================================
# CORS & Security Settings
# ==========================================
# Allowed CORS origins for web clients/frontends.
# Can be a comma-separated list or JSON array.
# Examples:
# CORS_ORIGINS="*"
# CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://myapp.com"
# CORS_ORIGINS='["http://localhost:3000", "https://myapp.com"]'
CORS_ORIGINS="*"

# ==========================================
# Cache Settings (In-Memory RAM Cache)
# ==========================================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAXSIZE=1000

# ==========================================
# HTTP Client & Network Settings
# ==========================================
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
DEFAULT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36"

# Optional HTTP Proxy URL (e.g. "http://proxy.example.com:8080")
# PROXY_URL=

# ==========================================
# Rate Limit Settings
# ==========================================
# Global API rate limit per minute (set to 0 to disable)
RATE_LIMIT_PER_MINUTE=120
